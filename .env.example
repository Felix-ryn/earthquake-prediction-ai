# IO paths
IO_TECTONIC_CSV=data/tectonic_events.csv
IO_VOLCANIC_CSV=data/volcanic_events.csv
IO_EVENTS_PATH=outputs/events.parquet
IO_EVENTS_ACO_PATH=outputs/events_aco.parquet
IO_EVENTS_ACO_GA_PATH=outputs/events_aco_ga.parquet
IO_EVENTS_ACO_GEOJSON_PATH=web/data/events_aco.geojson
IO_GA_VECTORS_GEOJSON_PATH=web/data/ga_vectors.geojson
IO_MODELS_DIR=models
IO_NB_METRICS_PATH=outputs/metrics_nb.json
IO_ROI_PATH=outputs/inference_roi.csv
IO_ROI_GEOJSON_PATH=web/data/inference_roi.geojson

# Pipeline
PIPELINE_SEQ_LEN=10

# ACO hyperparameters
ACO_N_ANTS=40
ACO_N_ITERS=25
ACO_NEIGHBOR_K=10
ACO_ALPHA=1.0
ACO_BETA=2.0
ACO_RHO=0.3
ACO_WALK_LENGTH=15
ACO_SEED=42

# GA hyperparameters
GA_FREQ=M
GA_MIN_EVENTS=5
GA_POP_SIZE=40
GA_N_GENERATIONS=120
GA_ELITE_FRAC=0.2
GA_MUTATION_STD_DEG=20.0
GA_SEED=42

# Train stage (set *_ENABLED=0 to skip)
TRAIN_ENABLED=1
TRAIN_SEQ_LEN=10
TRAIN_BATCH_SIZE=32
TRAIN_EPOCHS_CNN=25
TRAIN_EPOCHS_LSTM=25
TRAIN_LR=0.001
TRAIN_TEST_SIZE=0.3
TRAIN_RANDOM_STATE=42
TRAIN_LAMBDA_REG=0.5
TRAIN_LAMBDA_CLS=0.5


# Eval stage
EVAL_ENABLED=1
EVAL_TEST_SIZE=0.3
EVAL_RANDOM_STATE=42
EVAL_STRATIFY=true


# Predict stage
PREDICT_ENABLED=1
PREDICT_SEQ_LEN=10
